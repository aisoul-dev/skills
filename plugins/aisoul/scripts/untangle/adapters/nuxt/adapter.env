# Nuxt adapter settings, sourced by lib.sh when this adapter is active.
# shellcheck shell=bash
# shellcheck disable=SC2034  # read by the scripts that source lib.sh

DEFAULT_PATHS="app server shared src"
EXTS="ts tsx js mjs vue"
EXCLUDE_DIRS="node_modules .nuxt .output dist coverage"
# label|regex, added to the core patch census
EXTRA_PATTERNS=(
  'route-branch|route\.(name|path)\s*==='
)
